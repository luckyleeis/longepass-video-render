# 복사해서 .env 로 (git 에 올라가지 않음). 에이전트 방식(bin/lp)이 읽는다.
# 작업 폴더: 영상마다 <LP_WORKSPACE>/<slug>/ 가 생긴다 (초안·소재·음성·결과)
LP_WORKSPACE=/Volumes/Nini/longepass
# 선택: TTS (longepass.config.json 의 tts 보다 앞선다)
# LP_TTS_URL=http://192.168.45.21:8005/v1/audio/speech
# LP_TTS_VOICE=Aoede
# 기본 데이터(articles)와 업로드 대기열(longform_videos) — 백엔드(py-macmini-server)와 같은 DB. bin/lp 가 uv run --with psycopg 로 읽는다
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/certificate_tw
