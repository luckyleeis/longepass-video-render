{
  "_note": "효과음 목록. category의 설명/용도는 파일명과 팩 설명 기준의 초기값이라 실제로 들어보고 조정할 것. peak_db는 최대 음량(엔진이 음량을 맞추는 데 사용).",
  "categories": {
    "pop": {
      "description": "짧고 가벼운 '뽁' 소리. 작은 요소가 튀어나올 때",
      "use_for": [
        "element_in",
        "sticker_in",
        "tile_in"
      ]
    },
    "click": {
      "description": "아주 짧은 '틱' 클릭. 빠르게 연속되는 등장이나 커서 동작",
      "use_for": [
        "tick",
        "cursor",
        "list_item"
      ]
    },
    "check": {
      "description": "스위치/토글 '딸깍'. 체크박스가 체크될 때",
      "use_for": [
        "check"
      ]
    },
    "ding": {
      "description": "밝은 '띵'/확인음. 숫자 도달, 정답, 완료",
      "use_for": [
        "count_end",
        "success",
        "highlight"
      ]
    },
    "glass": {
      "description": "맑은 유리 '팅'. 반짝이는 강조, 가벼운 포인트",
      "use_for": [
        "sparkle",
        "highlight"
      ]
    },
    "bong": {
      "description": "둥근 '봉' 한 번. 섹션 시작, 묵직한 강조",
      "use_for": [
        "section"
      ]
    },
    "swish_up": {
      "description": "위로 '스윽' 열리는 UI 소리. 패널/카드가 펼쳐질 때",
      "use_for": [
        "panel_open",
        "card_spread"
      ]
    },
    "swish_down": {
      "description": "아래로 '스윽' 닫히는 UI 소리. 요소가 사라지거나 접힐 때",
      "use_for": [
        "panel_close",
        "element_out"
      ]
    },
    "glitch": {
      "description": "디지털 '지직' 글리치. 화면 전환, 반전 정보",
      "use_for": [
        "glitch_transition",
        "twist"
      ]
    },
    "scratch": {
      "description": "마커로 긁는 '슥' 소리. 밑줄/형광펜/줄긋기",
      "use_for": [
        "underline",
        "strike",
        "draw"
      ]
    },
    "error": {
      "description": "낮은 경고 '삑'. 오답, X 표시, 주의",
      "use_for": [
        "wrong",
        "warning"
      ]
    },
    "question": {
      "description": "물음표 느낌의 '띠링?'. 질문 제시",
      "use_for": [
        "question"
      ]
    },
    "whoosh": {
      "description": "공기를 가르는 '휙'(합성). 화면 전환, 큰 요소의 빠른 이동",
      "use_for": [
        "transition",
        "big_move"
      ]
    },
    "riser": {
      "description": "1초간 음높이가 올라가는 긴장감(합성). 큰 공개 직전",
      "use_for": [
        "build_up"
      ]
    },
    "impact": {
      "description": "낮은 '쿵'(합성). 큰 숫자/제목이 꽂힐 때",
      "use_for": [
        "slam",
        "big_reveal"
      ]
    },
    "stamp": {
      "description": "도장 찍는 '착'(합성). 인증/도장/확정",
      "use_for": [
        "stamp"
      ]
    }
  },
  "event_defaults": {
    "element_in": "pop",
    "sticker_in": "pop",
    "tile_in": "pop",
    "tick": "click",
    "cursor": "click",
    "list_item": "click",
    "check": "check",
    "count_end": "ding",
    "success": "ding",
    "highlight": "glass",
