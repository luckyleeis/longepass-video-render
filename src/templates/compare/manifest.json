          "item": {
            "type": "text",
            "max": 14,
            "required": true
          },
          "min": 0,
          "max": 3
        }
      },
      "required": true
    },
    "right": {
      "type": "object",
      "fields": {
        "label": {
          "type": "text",
          "max": 8,
          "required": true
        },
        "value": {
          "type": "text",
          "max": 8
        },
        "points": {
          "type": "list",
          "item": {
            "type": "text",
            "max": 14,
            "required": true
          },
          "min": 0,
          "max": 3
        }
      },
      "required": true
    },
    "verdict": {
      "type": "text",
      "max": 20
    }
  },
  "events": {
    "title": {
      "kind": "single",
      "at": 0.0
    },
    "left": {
      "kind": "single",
      "at": 0.15
    },
    "right": {
      "kind": "single",
      "at": 0.45
    },
    "verdict": {
      "kind": "single",
      "at": 0.8
    }
  },
  "sfx": {
